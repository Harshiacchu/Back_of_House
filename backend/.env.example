# Copy to backend/.env and fill in. Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=back_of_house
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# Where the site is opened in the browser (dev: Vite). Production: your deployed URL.
APP_URL=http://localhost:5173

# Optional: "Continue with Google". Create an OAuth client (Web application) in Google Cloud
# Console and add this authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: send verification emails through Brevo (free tier). Without these, codes are
# printed in the server terminal in development.
BREVO_API_KEY=
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Back of House
